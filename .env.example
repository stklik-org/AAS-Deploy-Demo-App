# .env.example
# Copy to .env and adjust values as required.
# These are overridden by any CLI arguments passed at container start time.

DEMO_WEB_HOST=0.0.0.0
DEMO_WEB_PORT=5000
DEMO_COLOR=#2563eb

DEMO_MQTT_HOST=localhost
DEMO_MQTT_PORT=1883
DEMO_MQTT_USER=
DEMO_MQTT_PASS=
DEMO_MQTT_TOPIC=demo/values
DEMO_MQTT_INTERVAL=5
